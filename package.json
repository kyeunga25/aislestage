{
  "name": "motive-ecommerce-visuals",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b --pretty false",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
    "cf:whoami": "wrangler whoami",
    "cf:migrate": "wrangler d1 migrations apply motive-beta --remote --config wrangler.jsonc",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run --config wrangler.jsonc",
    "cf:deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
    "cf:secrets": "wrangler secret list --config wrangler.jsonc",
    "cf:queue": "wrangler queues consumer list motive-generation-jobs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "wrangler": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
