{
  "name": "marketing-image-ai-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run cf:deploy",
    "cf:whoami": "wrangler whoami",
    "cf:migrate": "wrangler d1 migrations apply \"$CLOUDFLARE_D1_DATABASE_NAME\" --remote --config wrangler.local.jsonc",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run --config wrangler.jsonc",
    "cf:deploy": "npm run build && wrangler deploy --config wrangler.local.jsonc",
    "cf:secrets": "wrangler secret list --config wrangler.local.jsonc",
    "cf:queue": "wrangler queues consumer list \"$CLOUDFLARE_QUEUE_NAME\""
  },
  "dependencies": {
    "agents": "^0.19.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260723.1",
    "@types/node": "^26.1.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
