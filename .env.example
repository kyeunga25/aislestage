# Set with `wrangler secret put`, never commit production values.
OPENAI_API_KEY=
# Optional Worker variable. Keep deterministic unless assisted planning is deliberately enabled.
AGENT_MODE=deterministic
# Worker generation gate: disabled, deterministic, or assisted.
GENERATION_MODE=disabled
# Registration gate: closed, invite, or open. Production uses invite.
REGISTRATION_MODE=closed
# Number of deterministic outputs assigned to each newly invited workspace.
INITIAL_OUTPUT_ALLOWANCE=6
