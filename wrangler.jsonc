{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "replace-with-worker-name",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-22",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replace-with-d1-database-name",
      "database_id": "replace-with-protected-id",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "replace-with-r2-bucket-name" }],
  "queues": {
    "producers": [{ "binding": "GENERATION_QUEUE", "queue": "replace-with-generation-queue-name" }],
    "consumers": [{ "queue": "replace-with-generation-queue-name", "max_batch_size": 1, "max_retries": 3, "retry_delay": 60 }]
  },
  "vars": {
    "APP_ORIGIN": "https://example.invalid",
    "REGISTRATION_MODE": "closed",
    "GENERATION_MODE": "disabled"
  }
}
